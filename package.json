{
  "name": "finandex",
  "version": "0.1.0",
  "private": true,
  "description": "Finandex — Wawasan Indeks Pasar Keuangan Global. © 2026 Dea Saka Kurnia Putra. All rights reserved.",
  "author": "Dea Saka Kurnia Putra",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:api && vite build && npm run typecheck:server",
    "build:ci": "npm run data:fetch && npm run data:verify && npm run data:extract && npm run data:build && npm run test:golden && npm run build",
    "preview": "vite preview",
    "data:fetch": "tsx scripts/data/fetch-inputs.ts",
    "data:verify": "tsx scripts/data/verify-inputs.ts",
    "data:extract": "tsx scripts/data/extract.ts",
    "data:build": "tsx scripts/data/build-all.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && npm run typecheck:server",
    "typecheck:server": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --coverage",
    "test:golden": "vitest run --project golden",
    "test:tools": "vitest run --project tools",
    "test:parity": "tsx scripts/data/parity.ts",
    "eval:chat:mock": "tsx scripts/eval/eval-chat.ts --mock",
    "eval:chat": "tsx scripts/eval/eval-chat.ts --live",
    "e2e": "playwright test",
    "a11y": "playwright test tests/a11y",
    "lighthouse": "lhci autorun",
    "size": "size-limit",
    "check:copyright": "tsx scripts/brand/check-copyright.ts",
    "check:licenses": "tsx scripts/security/check-licenses.ts",
    "check:secrets": "tsx scripts/security/check-secrets.ts",
    "verify": "npm run lint && npm run typecheck && npm run check:copyright && npm run test && npm run test:golden && npm run test:tools && npm run eval:chat:mock && npm run build && npm run size && npm run check:licenses && npm run check:secrets && npm run e2e",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "npm run build:native && cap sync android && cap open android",
    "cap:ios": "npm run build:native && cap sync ios && cap open ios",
    "assets:generate": "python3 -I scripts/brand/make-native-assets.py",
    "assets:pdfjs": "tsx scripts/build/copy-pdfjs-assets.ts",
    "predev": "npm run assets:pdfjs",
    "prebuild": "npm run assets:pdfjs && npm run check:licenses",
    "build:native": "cross-env VITE_API_BASE_URL=https://finandex-beta.vercel.app VITE_DATA_BASE_URL=https://finandex-beta.vercel.app/data VITE_NATIVE=1 npm run build && tsx scripts/build/native-prune.ts",
    "build:api": "tsx scripts/build/bundle-api.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@scure/bip39": "2.4.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.21",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "i18next": "26.5.4",
    "idb-keyval": "6.3.0",
    "minisearch": "7.2.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "size-limit": "^14.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
